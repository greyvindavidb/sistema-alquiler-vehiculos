
@page "/danos"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using System.Text
@using Microsoft.EntityFrameworkCore
@using AlquilerVehiculos.Models
@using AlquilerVehiculos.Data

@inject IDbContextFactory<AlquilerDbContext> DbFactory

<PageTitle>Gestión de daños</PageTitle>

<h1>Gestión de daños</h1>
<p>Registro y consulta de daños asociados a los contratos.</p>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="alert alert-success">@mensaje</div>
}

@if (cargando)
{
    <p>Cargando información...</p>
}
else
{
    <div class="card mb-4">
        <div class="card-body">
            <h5>Registrar daño</h5>

            @if (contratos.Count == 0 || usuarios.Count == 0)
            {
                <div class="alert alert-warning">
                    Se necesita al menos un contrato y un usuario activo para registrar daños.
                </div>
            }
            else
            {
                <EditForm Model="formulario" OnValidSubmit="GuardarDano">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Contrato</label>
                            <InputSelect class="form-select"
                                         @bind-Value="formulario.IdContrato">
                                <option value="0">Seleccione un contrato</option>
                                @foreach (var contrato in contratos)
                                {
                                    <option value="@contrato.IdContrato">
                                        Contrato #@contrato.IdContrato -
                                        @contrato.IdClienteNavigation.Nombre
                                        @contrato.IdClienteNavigation.Apellido
                                    </option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => formulario.IdContrato" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Usuario que registra</label>
                            <InputSelect class="form-select"
                                         @bind-Value="formulario.IdUsuario">
                                <option value="0">Seleccione un usuario</option>
                                @foreach (var usuario in usuarios)
                                {
                                    <option value="@usuario.IdUsuario">
                                        @usuario.NombreCompleto
                                    </option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => formulario.IdUsuario" />
                        </div>

                        <div class="col-12 mb-3">
                            <label class="form-label">Descripción del daño</label>
                            <InputTextArea class="form-control"
                                           @bind-Value="formulario.Descripcion" />
                            <ValidationMessage For="() => formulario.Descripcion" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Costo</label>
                            <InputNumber class="form-control"
                                         @bind-Value="formulario.Costo"
                                         min="0"
                                         step="0.01" />
                            <ValidationMessage For="() => formulario.Costo" />
                        </div>

                        <div class="col-12 mb-3">
                            <div class="form-check">
                                <InputCheckbox class="form-check-input"
                                               @bind-Value="formulario.GenerarCargo" />
                                <label class="form-check-label">
                                    Generar cargo automáticamente
                                </label>
                            </div>
                            <small class="text-muted">
                                Si se marca, se creará un cargo de tipo Daño
                                por el mismo costo.
                            </small>
                        </div>
                    </div>

                    <button type="submit"
                            class="btn btn-primary"
                            disabled="@guardando">
                        @if (guardando)
                        {
                            <span>Guardando...</span>
                        }
                        else
                        {
                            <span>Registrar daño</span>
                        }
                    </button>
                </EditForm>
            }
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h5>Datos disponibles</h5>
            <p>Contratos: @contratos.Count</p>
            <p>Usuarios activos: @usuarios.Count</p>
            <p>Daños registrados: @danos.Count</p>
        </div>
    </div>

    <h5>Daños registrados</h5>

    @if (danos.Count == 0)
    {
        <div class="alert alert-info">
            Todavía no hay daños registrados.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID daño</th>
                        <th>N.º contrato</th>
                        <th>Cliente</th>
                        <th>Vehículo</th>
                        <th>Descripción</th>
                        <th>Costo</th>
                        <th>Usuario</th>
                        <th>Fecha</th>
                        <th>Cargo</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dano in danos)
                    {
                        <tr @key="dano.IdDano">
                            <td>@dano.IdDano</td>
                            <td>#@dano.IdContrato</td>
                            <td>
                                @dano.IdContratoNavigation.IdClienteNavigation.Nombre
                                @dano.IdContratoNavigation.IdClienteNavigation.Apellido
                            </td>
                            <td>
                                @dano.IdContratoNavigation.IdVehiculoNavigation.Marca
                                @dano.IdContratoNavigation.IdVehiculoNavigation.Modelo
                            </td>
                            <td>@dano.Descripcion</td>
                            <td>@dano.Costo.ToString("N2")</td>
                            <td>@dano.IdUsuarioNavigation.NombreCompleto</td>
                            <td>@dano.FechaRegistro.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (dano.IdCargo.HasValue)
                                {
                                    <span class="badge bg-success">Generado</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No generado</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private List<Dano> danos = new();
    private List<Contrato> contratos = new();
    private List<Usuario> usuarios = new();

    private FormularioDano formulario = new();

    private bool cargando = true;
    private bool guardando;
    private string? error;
    private string? mensaje;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        cargando = true;
        error = null;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            contratos = await db.Contrato
                .AsNoTracking()
                .Include(c => c.IdClienteNavigation)
                .Include(c => c.IdVehiculoNavigation)
                .OrderByDescending(c => c.IdContrato)
                .ToListAsync();

            usuarios = await db.Usuario
                .AsNoTracking()
                .Where(u => u.Activo)
                .OrderBy(u => u.NombreCompleto)
                .ToListAsync();

            danos = await db.Dano
                .AsNoTracking()
                .Include(d => d.IdContratoNavigation)
                    .ThenInclude(c => c.IdClienteNavigation)
                .Include(d => d.IdContratoNavigation)
                    .ThenInclude(c => c.IdVehiculoNavigation)
                .Include(d => d.IdUsuarioNavigation)
                .OrderByDescending(d => d.FechaRegistro)
                .ToListAsync();
        }
        catch (Exception)
        {
            error = "No se pudieron cargar los datos. Verifica la conexión con SQL Server.";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task GuardarDano()
    {
        error = null;
        mensaje = null;

        if (formulario.IdContrato <= 0 || formulario.IdUsuario <= 0)
        {
            error = "Debes seleccionar un contrato y un usuario.";
            return;
        }

        if (formulario.Costo < 0)
        {
            error = "El costo no puede ser negativo.";
            return;
        }

        if (formulario.GenerarCargo && formulario.Costo <= 0)
        {
            error = "El costo debe ser mayor que cero para generar un cargo.";
            return;
        }

        guardando = true;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var contratoExiste = await db.Contrato
                .AnyAsync(c => c.IdContrato == formulario.IdContrato);

            var usuarioExiste = await db.Usuario
                .AnyAsync(u => u.IdUsuario == formulario.IdUsuario && u.Activo);

            if (!contratoExiste || !usuarioExiste)
            {
                error = "El contrato o el usuario seleccionado no está disponible.";
                return;
            }

            TipoCargo? tipoDano = null;

            if (formulario.GenerarCargo)
            {
                var tiposActivos = await db.TipoCargo
                    .Where(t => t.Activo)
                    .ToListAsync();

                tipoDano = tiposActivos.FirstOrDefault(t =>
                    NormalizarTexto(t.Nombre) == "dano");

                if (tipoDano == null)
                {
                    error = "No se encontró un tipo de cargo activo llamado Daño.";
                    return;
                }
            }

            await using var transaccion =
                await db.Database.BeginTransactionAsync();

            var fechaRegistro = DateTime.Now;
            var descripcion = formulario.Descripcion.Trim();

            var nuevoDano = new Dano
            {
                IdContrato = formulario.IdContrato,
                IdUsuario = formulario.IdUsuario,
                Descripcion = descripcion,
                Costo = formulario.Costo,
                FechaRegistro = fechaRegistro
            };

            if (formulario.GenerarCargo)
            {
                var descripcionCargo = descripcion.Length > 200
                    ? descripcion[..200]
                    : descripcion;

                var nuevoCargo = new Cargo
                {
                    IdContrato = formulario.IdContrato,
                    IdTipoCargo = tipoDano!.IdTipoCargo,
                    Descripcion = descripcionCargo,
                    Monto = formulario.Costo,
                    Fecha = fechaRegistro
                };

                db.Cargo.Add(nuevoCargo);
                await db.SaveChangesAsync();

                nuevoDano.IdCargo = nuevoCargo.IdCargo;
            }

            db.Dano.Add(nuevoDano);
            await db.SaveChangesAsync();

            await transaccion.CommitAsync();

            mensaje = formulario.GenerarCargo
                ? "Daño registrado y cargo generado correctamente."
                : "Daño registrado correctamente.";

            formulario = new FormularioDano();

            await CargarDatos();
        }
        catch (Exception)
        {
            error = "No se pudo registrar el daño. Verifica los datos e intenta nuevamente.";
        }
        finally
        {
            guardando = false;
        }
    }

    private static string NormalizarTexto(string texto)
    {
        var normalizado = texto.Normalize(NormalizationForm.FormD);

        var caracteres = normalizado.Where(c =>
            CharUnicodeInfo.GetUnicodeCategory(c) !=
            UnicodeCategory.NonSpacingMark);

        return new string(caracteres.ToArray()).Trim().ToLowerInvariant();
    }

    private class FormularioDano
    {
        [Range(1, int.MaxValue, ErrorMessage = "Selecciona un contrato.")]
        public int IdContrato { get; set; }

        [Range(1, int.MaxValue, ErrorMessage = "Selecciona un usuario.")]
        public int IdUsuario { get; set; }

        [Required(ErrorMessage = "La descripción es obligatoria.")]
        [StringLength(300, ErrorMessage = "La descripción no puede superar los 300 caracteres.")]
        public string Descripcion { get; set; } = string.Empty;

        [Range(typeof(decimal), "0", "99999999.99",
            ErrorMessage = "El costo debe ser igual o mayor que cero.")]
        public decimal Costo { get; set; }

        public bool GenerarCargo { get; set; }
    }
}
