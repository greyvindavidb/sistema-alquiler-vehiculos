@page "/mantenimientos"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@using AlquilerVehiculos.Data
@using AlquilerVehiculos.Models

@inject IDbContextFactory<AlquilerDbContext> DbFactory

<PageTitle>Mantenimientos</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1"><i class="bi bi-tools text-primary me-2"></i>Gestión de mantenimientos</h1>
            <p class="text-secondary mb-0">Administra los mantenimientos de los vehículos.</p>
        </div>
        <button class="btn btn-primary px-3" @onclick="NuevoMantenimiento" disabled="@guardando">
            <i class="bi bi-plus-circle me-2"></i>Nuevo mantenimiento
        </button>
    </div>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="alert alert-success">@mensaje</div>
}

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}

@if (cargando)
{
    <p>Cargando mantenimientos...</p>
}
else
{
    @if (mostrarFormulario)
    {
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white border-0 px-4 pt-4">
                <h2 class="h5 fw-bold mb-1"><i class="bi bi-wrench-adjustable text-primary me-2"></i>@(esEdicion ? "Editar mantenimiento" : "Registrar mantenimiento")</h2>
                <p class="text-secondary small mb-0">Completa los datos del mantenimiento.</p>
            </div>
            <div class="card-body p-4">

                <EditForm Model="@formulario" OnValidSubmit="@Guardar">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Vehículo *</label>
                        <InputSelect class="form-select"
                                     @bind-Value="formulario.IdVehiculo">
                            <option value="0">Seleccione un vehículo</option>
                            @foreach (var vehiculo in vehiculos)
                            {
                                <option value="@vehiculo.IdVehiculo">
                                    @vehiculo.Matricula - @vehiculo.Marca @vehiculo.Modelo
                                </option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => formulario.IdVehiculo)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tipo *</label>
                        <InputSelect class="form-select" @bind-Value="formulario.Tipo">
                            <option value="">Seleccione el tipo</option>
                            <option value="preventivo">Preventivo</option>
                            <option value="correctivo">Correctivo</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => formulario.Tipo)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Descripción *</label>
                        <InputTextArea class="form-control"
                                       @bind-Value="formulario.Descripcion"
                                       maxlength="300" />
                        <small class="text-muted">Máximo 300 caracteres.</small>
                        <ValidationMessage For="@(() => formulario.Descripcion)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Taller</label>
                        <InputText class="form-control"
                                   @bind-Value="formulario.Taller"
                                   maxlength="100" />
                        <small class="text-muted">Máximo 100 caracteres.</small>
                        <ValidationMessage For="@(() => formulario.Taller)" />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Fecha de inicio *</label>
                            <InputDate class="form-control"
                                       @bind-Value="formulario.FechaInicio" />
                            <ValidationMessage For="@(() => formulario.FechaInicio)" />
                        </div>

                       <div class="col-md-6 mb-3">
    <label class="form-label fw-semibold">Fecha de finalización</label>
    <InputDate TValue="DateOnly?"
               class="form-control"
               @bind-Value="formulario.FechaFin" />
    <small class="text-muted">Déjala vacía si el mantenimiento sigue en curso.</small>
</div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Costo *</label>
                            <InputNumber class="form-control"
                                         @bind-Value="formulario.Costo"
                                         min="0" step="0.01" />
                            <ValidationMessage For="@(() => formulario.Costo)" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Kilometraje</label>
                            <InputNumber class="form-control"
                                         @bind-Value="formulario.Kilometraje"
                                         min="0" />
                            <ValidationMessage For="@(() => formulario.Kilometraje)" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Estado *</label>
                        <InputSelect class="form-select" @bind-Value="formulario.Estado">
                            <option value="en_curso">En curso</option>
                            <option value="completado">Completado</option>
                        </InputSelect>
                    </div>

                    <button type="submit" class="btn btn-primary px-4 me-2"
                            disabled="@guardando">
                        @(guardando ? "Guardando..." : "Guardar")
                    </button>

                    <button type="button" class="btn btn-outline-secondary"
                            @onclick="Cancelar" disabled="@guardando">
                        Cancelar
                    </button>
                </EditForm>
            </div>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white border-0 p-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h2 class="h5 fw-bold mb-1"><i class="bi bi-card-list text-primary me-2"></i>Mantenimientos registrados</h2>
                    <p class="text-secondary small mb-0">Historial y estado actual de los mantenimientos.</p>
                </div>
                <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">Total: @mantenimientos.Count</span>
            </div>
        </div>
        <div class="card-body p-0">
    @if (mantenimientos.Count == 0)
    {
        <div class="alert alert-info m-3">
            No hay mantenimientos registrados.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Vehículo</th>
                        <th>Tipo</th>
                        <th>Descripción</th>
                        <th>Taller</th>
                        <th>Fecha inicio</th>
                        <th>Fecha fin</th>
                        <th>Costo</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in mantenimientos)
                    {
                        <tr @key="m.IdMantenimiento">
                            <td>@m.IdVehiculoNavigation.Matricula</td>
                            <td>@(m.Tipo == "preventivo" ? "Preventivo" : "Correctivo")</td>
                            <td>@m.Descripcion</td>
                            <td>@(m.Taller ?? "—")</td>
                            <td>@m.FechaInicio.ToString("dd/MM/yyyy")</td>
                            <td>@(m.FechaFin?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td>@m.Costo.ToString("N2")</td>
                            <td><span class="badge rounded-pill px-3 py-2 @(m.Estado == "en_curso" ? "bg-warning-subtle text-warning-emphasis" : "bg-success-subtle text-success-emphasis")">@(m.Estado == "en_curso" ? "En curso" : "Completado")</span></td>
                            <td>
                                <div class="d-flex flex-nowrap gap-2">
                                    <button class="btn btn-sm btn-outline-primary flex-shrink-0"
                                            @onclick="() => Editar(m.IdMantenimiento)"
                                            disabled="@guardando">
                                        <i class="bi bi-pencil-square me-1"></i>Editar
                                    </button>
@if (m.Estado == "en_curso")
{
    <button class="btn btn-sm btn-success flex-shrink-0"
            @onclick="() => CambiarEstado(m.IdMantenimiento)"
            disabled="@guardando">
        <i class="bi bi-check-circle me-1"></i>Finalizar
    </button>
}
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
        </div>
    </div>

}
</div>

@code {
    private List<Mantenimiento> mantenimientos = new();
    private List<Vehiculo> vehiculos = new();

    private FormularioMantenimiento formulario = new();

    private bool cargando = true;
    private bool guardando;
    private bool mostrarFormulario;
    private bool esEdicion;

    private int? idEdicion;

    private string? mensaje;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        cargando = true;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            mantenimientos = await db.Mantenimiento
                .AsNoTracking()
                .Include(m => m.IdVehiculoNavigation)
                .OrderBy(m => m.IdMantenimiento)
                .ToListAsync();

            vehiculos = await db.Vehiculo
                .AsNoTracking()
                .OrderBy(v => v.IdVehiculo)
                .ToListAsync();
        }
        catch (Exception)
        {
            error = "No se pudieron cargar los datos del módulo.";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task NuevoMantenimiento()
    {
        error = null;
        mensaje = null;

        await CargarDatos();

        formulario = new FormularioMantenimiento
        {
            FechaInicio = DateOnly.FromDateTime(DateTime.Today),
            Estado = "en_curso"
        };

        idEdicion = null;
        esEdicion = false;
        mostrarFormulario = true;
    }

    private async Task Editar(int id)
    {
        error = null;
        mensaje = null;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var m = await db.Mantenimiento
                .AsNoTracking()
                .FirstOrDefaultAsync(x => x.IdMantenimiento == id);

            if (m is null)
            {
                error = "El mantenimiento ya no existe.";
                return;
            }

            formulario = new FormularioMantenimiento
            {
                IdVehiculo = m.IdVehiculo,
                Tipo = m.Tipo,
                Descripcion = m.Descripcion,
                Taller = m.Taller,
                FechaInicio = m.FechaInicio,
                FechaFin = m.FechaFin,
                Costo = m.Costo,
                Kilometraje = m.Kilometraje,
                Estado = m.Estado
            };

            idEdicion = id;
            esEdicion = true;
            mostrarFormulario = true;

            await CargarDatos();
        }
        catch (Exception)
        {
            error = "No se pudo cargar el mantenimiento.";
        }
    }

    private async Task Guardar()
    {
        if (guardando)
            return;

        guardando = true;
        error = null;
        mensaje = null;

        try
        {
            if (formulario.IdVehiculo <= 0)
            {
                error = "Debes seleccionar un vehículo.";
                return;
            }

            if (formulario.FechaFin.HasValue &&
                formulario.FechaFin.Value < formulario.FechaInicio)
            {
                error = "La fecha de finalización no puede ser anterior a la fecha de inicio.";
                return;
            }

            if (formulario.Estado == "completado" &&
                !formulario.FechaFin.HasValue)
            {
                error = "Debes indicar la fecha de finalización para completar el mantenimiento.";
                return;
            }

          if (formulario.Estado == "en_curso")
{
    formulario.FechaFin = null;
}
else if (!formulario.FechaFin.HasValue)
{
    error = "Debes indicar la fecha de finalización.";
    return;
}

            await using var db = await DbFactory.CreateDbContextAsync();
            await using var transaction = await db.Database.BeginTransactionAsync();

            var vehiculo = await db.Vehiculo
                .FirstOrDefaultAsync(v => v.IdVehiculo == formulario.IdVehiculo);

            if (vehiculo is null)
            {
                error = "El vehículo seleccionado no existe.";
                return;
            }

            bool yaTieneMantenimiento = await db.Mantenimiento.AnyAsync(m =>
                 m.IdVehiculo == formulario.IdVehiculo &&
                 m.Estado == "en_curso" &&
                (!esEdicion || m.IdMantenimiento != idEdicion));

            if (formulario.Estado == "en_curso" && yaTieneMantenimiento)
               {
                   error = "Este vehículo ya tiene un mantenimiento en curso. Finalízalo antes de registrar otro.";
                   return;
           }

            Mantenimiento mantenimiento;

            if (esEdicion && idEdicion.HasValue)
            {
                mantenimiento = await db.Mantenimiento
                    .FirstOrDefaultAsync(m => m.IdMantenimiento == idEdicion.Value)
                    ?? throw new InvalidOperationException("El mantenimiento ya no existe.");
            }
            else
            {
                mantenimiento = new Mantenimiento();
                db.Mantenimiento.Add(mantenimiento);
            }

            mantenimiento.IdVehiculo = formulario.IdVehiculo;
            mantenimiento.Tipo = formulario.Tipo;
            mantenimiento.Descripcion = formulario.Descripcion.Trim();
            mantenimiento.Taller = Limpiar(formulario.Taller);
            mantenimiento.FechaInicio = formulario.FechaInicio;
            mantenimiento.FechaFin = formulario.FechaFin;
            mantenimiento.Costo = formulario.Costo;
            mantenimiento.Kilometraje = formulario.Kilometraje;
            mantenimiento.Estado = formulario.Estado;

            if (formulario.Estado == "en_curso")
            {
                vehiculo.Estado = "en_mantenimiento";
            }
            else
            {
                bool tieneOtroMantenimiento = await db.Mantenimiento.AnyAsync(m =>
                    m.IdVehiculo == formulario.IdVehiculo &&
                    m.Estado == "en_curso" &&
                    (!esEdicion || m.IdMantenimiento != idEdicion));

                if (!tieneOtroMantenimiento &&
                    vehiculo.Estado == "en_mantenimiento")
                {
                    vehiculo.Estado = "activo";
                }
            }

            await db.SaveChangesAsync();
            await transaction.CommitAsync();

            mensaje = esEdicion
                ? "Mantenimiento actualizado correctamente."
                : "Mantenimiento registrado correctamente.";

            mostrarFormulario = false;
            await CargarDatos();
        }
        catch (DbUpdateException)
        {
            error = "No se pudo guardar el mantenimiento. Verifica los datos y las restricciones de la base de datos.";
        }
        catch (Exception)
        {
            error = "Ocurrió un error al guardar el mantenimiento.";
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task CambiarEstado(int id)
    {
        if (guardando)
            return;

        guardando = true;
        error = null;
        mensaje = null;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await using var transaction = await db.Database.BeginTransactionAsync();

            var m = await db.Mantenimiento
                .FirstOrDefaultAsync(x => x.IdMantenimiento == id);

            if (m is null)
            {
                error = "El mantenimiento ya no existe.";
                return;
            }

            var vehiculo = await db.Vehiculo
                .FirstOrDefaultAsync(v => v.IdVehiculo == m.IdVehiculo);

            if (vehiculo is null)
            {
                error = "No se encontró el vehículo relacionado.";
                return;
            }

            if (m.Estado == "en_curso")
            {
                m.Estado = "completado";
                m.FechaFin = DateOnly.FromDateTime(DateTime.Today);

                bool otroPendiente = await db.Mantenimiento.AnyAsync(x =>
                    x.IdVehiculo == m.IdVehiculo &&
                    x.Estado == "en_curso" &&
                    x.IdMantenimiento != id);

                if (!otroPendiente && vehiculo.Estado == "en_mantenimiento")
                    vehiculo.Estado = "activo";

                mensaje = "Mantenimiento finalizado correctamente.";
            }
          

            await db.SaveChangesAsync();
            await transaction.CommitAsync();

            await CargarDatos();
        }
        catch (Exception)
        {
            error = "No se pudo cambiar el estado del mantenimiento.";
        }
        finally
        {
            guardando = false;
        }
    }

    private void Cancelar()
    {
        mostrarFormulario = false;
        formulario = new FormularioMantenimiento();
        idEdicion = null;
        esEdicion = false;
    }

    private static string? Limpiar(string? texto)
    {
        return string.IsNullOrWhiteSpace(texto) ? null : texto.Trim();
    }

    private sealed class FormularioMantenimiento
    {
        [Range(1, int.MaxValue, ErrorMessage = "Selecciona un vehículo.")]
        public int IdVehiculo { get; set; }

        [Required(ErrorMessage = "Selecciona el tipo de mantenimiento.")]
        public string Tipo { get; set; } = "";

        [Required(ErrorMessage = "La descripción es obligatoria.")]
        [StringLength(300, ErrorMessage = "Máximo 300 caracteres.")]
        public string Descripcion { get; set; } = "";

        [StringLength(100, ErrorMessage = "Máximo 100 caracteres.")]
        public string? Taller { get; set; }

        [Required]
        public DateOnly FechaInicio { get; set; }

        public DateOnly? FechaFin { get; set; }

        [Range(typeof(decimal), "0", "99999999.99",
            ErrorMessage = "El costo debe ser igual o mayor que cero.")]
        public decimal Costo { get; set; }

        [Range(0, int.MaxValue,
            ErrorMessage = "El kilometraje no puede ser negativo.")]
        public int? Kilometraje { get; set; }

        [Required]
        public string Estado { get; set; } = "en_curso";
    }
}
