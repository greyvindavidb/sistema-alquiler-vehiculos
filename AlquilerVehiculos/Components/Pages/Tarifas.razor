@page "/tarifas"
@rendermode InteractiveServer

@using AlquilerVehiculos.Data
@using AlquilerVehiculos.Models
@using Microsoft.EntityFrameworkCore

@inject IDbContextFactory<AlquilerDbContext> DbFactory
@inject ILogger<Tarifas> Logger

<PageTitle>Tarifas de alquiler</PageTitle>

<div class="container-fluid py-4">
    <div class="mb-4">
        <h1 class="h3 fw-bold mb-1">
            <i class="bi bi-tags-fill text-primary me-2"></i>
            Tarifas de alquiler
        </h1>
        <p class="text-secondary mb-0">
            Administra el precio diario por categoría. Cada cambio conserva el precio anterior en el historial.
        </p>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="alert @(mensajeError ? "alert-danger" : "alert-success")" role="alert">
            @mensaje
        </div>
    }

    @if (cargando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white px-4 pt-4 border-0">
                <h2 class="h5 fw-bold mb-1">Registrar una tarifa</h2>
                <p class="text-secondary small mb-0">
                    Al guardar, la tarifa activa anterior de esa categoría quedará inactiva.
                </p>
            </div>
            <div class="card-body p-4">
                @if (categorias.Count == 0)
                {
                    <div class="alert alert-warning mb-0">
                        Registra al menos una categoría antes de crear tarifas.
                    </div>
                }
                else
                {
                    <EditForm Model="formulario" OnValidSubmit="GuardarTarifaAsync">
                        <div class="row g-3 align-items-end">
                            <div class="col-12 col-md-5">
                                <label class="form-label fw-semibold" for="categoria">Categoría</label>
                                <InputSelect id="categoria" class="form-select" @bind-Value="formulario.IdCategoria">
                                    <option value="0">Seleccione una categoría</option>
                                    @foreach (var categoria in categorias)
                                    {
                                        <option value="@categoria.IdCategoria">@categoria.Nombre</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label fw-semibold" for="precio">Precio por día</label>
                                <InputNumber id="precio" class="form-control" @bind-Value="formulario.PrecioDia" min="0.01" step="0.01" />
                            </div>
                            <div class="col-12 col-md-3">
                                <button type="submit" class="btn btn-primary w-100" disabled="@guardando">
                                    @(guardando ? "Guardando..." : "Guardar tarifa")
                                </button>
                            </div>
                        </div>
                    </EditForm>
                }
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white px-4 pt-4 border-0">
                <h2 class="h5 fw-bold mb-0">Tarifas actuales e historial</h2>
            </div>
            @if (tarifas.Count == 0)
            {
                <div class="card-body text-secondary">Todavía no hay tarifas registradas.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="px-4">Categoría</th>
                                <th>Precio por día</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tarifa in tarifas)
                            {
                                <tr @key="tarifa.IdTarifa">
                                    <td class="px-4">@tarifa.NombreCategoria</td>
                                    <td>@tarifa.PrecioDia.ToString("C2")</td>
                                    <td>
                                        @if (tarifa.Activa)
                                        {
                                            <span class="badge text-bg-success">Activa</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-secondary">Histórica</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Categoria> categorias = new();
    private List<TarifaFila> tarifas = new();
    private FormularioTarifa formulario = new();
    private bool cargando = true;
    private bool guardando;
    private bool mensajeError;
    private string? mensaje;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatosAsync();
    }

    private async Task CargarDatosAsync()
    {
        cargando = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            categorias = await db.Categoria
                .AsNoTracking()
                .OrderBy(c => c.Nombre)
                .ToListAsync();

            tarifas = await (
                from tarifa in db.Tarifa.AsNoTracking()
                join categoria in db.Categoria.AsNoTracking()
                    on tarifa.IdCategoria equals categoria.IdCategoria
                orderby categoria.Nombre, tarifa.Activa descending, tarifa.IdTarifa descending
                select new TarifaFila
                {
                    IdTarifa = tarifa.IdTarifa,
                    NombreCategoria = categoria.Nombre,
                    PrecioDia = tarifa.PrecioDia,
                    Activa = tarifa.Activa
                })
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No se pudieron cargar las tarifas.");
            mensaje = "No se pudieron cargar las tarifas. Verifica la conexión con la base de datos.";
            mensajeError = true;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task GuardarTarifaAsync()
    {
        if (guardando)
        {
            return;
        }

        if (formulario.IdCategoria <= 0 ||
            formulario.PrecioDia <= 0 ||
            formulario.PrecioDia > 99999999.99m)
        {
            MostrarMensaje("Selecciona una categoría y un precio mayor que cero.", true);
            return;
        }

        guardando = true;
        mensaje = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            if (!await db.Categoria.AnyAsync(c => c.IdCategoria == formulario.IdCategoria))
            {
                MostrarMensaje("La categoría seleccionada ya no existe.", true);
                return;
            }

            var tarifasActivas = await db.Tarifa
                .Where(t => t.IdCategoria == formulario.IdCategoria && t.Activa)
                .ToListAsync();

            if (tarifasActivas.Any(t => t.PrecioDia == formulario.PrecioDia))
            {
                MostrarMensaje("Ese precio ya está activo para la categoría seleccionada.", true);
                return;
            }

            await using var transaccion = await db.Database.BeginTransactionAsync();
            foreach (var tarifa in tarifasActivas)
            {
                tarifa.Activa = false;
            }

            db.Tarifa.Add(new Tarifa
            {
                IdCategoria = formulario.IdCategoria,
                PrecioDia = formulario.PrecioDia,
                Activa = true
            });

            await db.SaveChangesAsync();
            await transaccion.CommitAsync();

            formulario = new FormularioTarifa();
            await CargarDatosAsync();
            MostrarMensaje("La tarifa se registró correctamente.", false);
        }
        catch (DbUpdateException ex)
        {
            Logger.LogError(ex, "No se pudo guardar la tarifa.");
            MostrarMensaje("No se pudo guardar la tarifa. Puede que otra operación haya actualizado esa categoría.", true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ocurrió un error al guardar la tarifa.");
            MostrarMensaje("Ocurrió un error al guardar la tarifa.", true);
        }
        finally
        {
            guardando = false;
        }
    }

    private void MostrarMensaje(string texto, bool error)
    {
        mensaje = texto;
        mensajeError = error;
    }

    private sealed class FormularioTarifa
    {
        public int IdCategoria { get; set; }
        public decimal PrecioDia { get; set; }
    }

    private sealed class TarifaFila
    {
        public int IdTarifa { get; set; }
        public string NombreCategoria { get; set; } = "";
        public decimal PrecioDia { get; set; }
        public bool Activa { get; set; }
    }
}
