@page "/login"
 @attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrador")]
@layout AlquilerVehiculos.Components.Layout.LoginLayout
@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Iniciar sesión · Alquiler de Vehículos</PageTitle>

<div class="login-screen">
    <div class="login-card">
        <div class="login-icon"><i class="bi bi-car-front-fill"></i></div>
        <h1>Bienvenido</h1>
        <p class="text-muted mb-4">Ingresa tus credenciales para continuar.</p>

        @if (Error == "1")
        {
            <div class="alert alert-danger" role="alert">Usuario o contraseña incorrectos, o cuenta inactiva.</div>
        }

        <form action="/auth/login" method="post">
            <input type="hidden" name="__RequestVerificationToken" value="@Token" />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            <label for="usuario" class="form-label fw-semibold">Usuario</label>
            <div class="input-group mb-3">
                <span class="input-group-text"><i class="bi bi-person"></i></span>
                <input id="usuario" name="usuario" type="text" autocomplete="username"
                       maxlength="50" class="form-control" required autofocus />
            </div>
            <label for="contrasena" class="form-label fw-semibold">Contraseña</label>
            <div class="input-group mb-4">
                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                <input id="contrasena" name="contrasena" type="password"
                       autocomplete="current-password" class="form-control" required />
            </div>
            <button class="btn btn-primary w-100 py-2" type="submit">
                <i class="bi bi-box-arrow-in-right me-2"></i>Iniciar sesión
            </button>
        </form>
    </div>
</div>

<style>
    .login-screen { min-height: 100vh; display: flex; align-items: center; justify-content: center;
        background: linear-gradient(135deg,#0e1c37,#153b75); padding: 24px; }
    .login-card { background: #fff; width: 100%; max-width: 440px; border-radius: 18px;
        padding: 40px; box-shadow: 0 20px 70px rgba(0,0,0,.2); }
    .login-card h1 { font-size: 1.8rem; font-weight: 750; margin-bottom: 8px; }
    .login-icon { width: 56px; height: 56px; border-radius: 14px; background: #eaf1ff;
        color: #1764c0; font-size: 30px; display: grid; place-items: center; margin-bottom: 22px; }
    .login-card .form-control { min-height: 46px; }
    .login-card .btn { background: #1764c0; border-color: #1764c0; font-weight: 600; }
</style>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "ReturnUrl")]
    public string? ReturnUrl { get; set; }

    private string? Token => HttpContextAccessor.HttpContext is { } ctx
        ? Antiforgery.GetAndStoreTokens(ctx).RequestToken
        : null;
}
