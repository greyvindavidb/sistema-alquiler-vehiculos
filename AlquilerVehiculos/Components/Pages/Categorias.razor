@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@page "/categorias"

@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@using Microsoft.Data.SqlClient
@using AlquilerVehiculos.Data
@using AlquilerVehiculos.Models

@inject IDbContextFactory<AlquilerDbContext> DbFactory

<PageTitle>Categorías</PageTitle>

<div class="container-fluid py-4">
    <div class="mb-4">
        <h1 class="h3 fw-bold mb-1">
            <i class="bi bi-tags-fill text-primary me-2"></i>Gestión de categorías
        </h1>
        <p class="text-secondary mb-0">Administra las categorías disponibles para el alquiler de vehículos.</p>
    </div>
    <div class="mb-4">
        <button class="btn btn-primary px-4" @onclick="NuevaCategoria" disabled="@guardando">
            <i class="bi bi-plus-circle me-2"></i>Nueva categoría
        </button>
    </div>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="alert alert-success" role="alert">
        @mensaje
    </div>
}

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger" role="alert">
        @error
    </div>
}

@if (cargando)
{
    <p>Cargando categorías...</p>
}
else
{
    @if (mostrandoFormulario)
    {
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white border-0 px-4 pt-4">
                <h2 class="h5 fw-bold mb-1"><i class="bi bi-pencil-square text-primary me-2"></i>@(esEdicion ? "Editar" : "Registrar") categoría</h2>
                <p class="text-secondary small mb-0">Complete los datos solicitados.</p>
            </div>
            <div class="card-body p-4">

                <EditForm Model="@formulario"
                          OnValidSubmit="@GuardarCategoria">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label for="nombre" class="form-label fw-semibold">
                            Nombre
                        </label>

                        <InputText id="nombre"
                                   class="form-control"
                                   @bind-Value="formulario.Nombre" />

                        <ValidationMessage For="@(() => formulario.Nombre)" />
                    </div>

                    <div class="mb-3">
                        <label for="descripcion" class="form-label fw-semibold">
                            Descripción
                        </label>

                        <InputTextArea id="descripcion"
                                       class="form-control"
                                       @bind-Value="formulario.Descripcion" maxlength="200" />
                                       
                        <ValidationMessage For="@(() => formulario.Descripcion)" />
                    </div>

                    <button type="submit"
                            class="btn btn-primary px-4 me-2"
                            disabled="@guardando">
                        @(guardando ? "Guardando..." : "Guardar")
                    </button>

                    <button type="button"
                            class="btn btn-outline-secondary"
                            @onclick="CancelarFormulario"
                            disabled="@guardando">
                        Cancelar
                    </button>
                </EditForm>
            </div>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white border-0 p-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h2 class="h5 fw-bold mb-1"><i class="bi bi-card-list text-primary me-2"></i>Categorías registrados</h2>
                    <p class="text-secondary small mb-0">Listado de categorías del sistema.</p>
                </div>
                <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">
                    Total: @categorias.Count
                </span>
            </div>
        </div>
        <div class="card-body p-0">
    @if (categorias.Count == 0)
    {
        <div class="alert alert-info m-3">
            No hay categorías registradas.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var categoria in categorias)
                    {
                        <tr @key="categoria.IdCategoria">
                            <td>@categoria.Nombre</td>
                            <td class="descripcion-categoria">@(categoria.Descripcion ?? "Sin descripción")</td>
                            <td class="text-end text-nowrap">
                                <button class="btn btn-sm btn-outline-primary me-1"
                                        @onclick="() => EditarCategoria(categoria.IdCategoria)"
                                        disabled="@guardando">
                                    Editar
                                </button>

                                <button class="btn btn-sm btn-outline-danger"
                                        @onclick="() => EliminarCategoria(categoria.IdCategoria)"
                                        disabled="@guardando">
                                    Eliminar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    </div>
</div>
}

</div>

<style>
    .tabla-categorias {
        table-layout: fixed;
        width: 100%;
    }

    .tabla-categorias th,
    .tabla-categorias td {
        overflow-wrap: anywhere;
        vertical-align: middle;
    }

    .tabla-categorias th:nth-child(1) { width: 8%; }
    .tabla-categorias th:nth-child(2) { width: 20%; }
    .tabla-categorias th:nth-child(3) { width: 47%; }
    .tabla-categorias th:nth-child(4) { width: 25%; }

    .tabla-categorias .descripcion-categoria {
        overflow-wrap: anywhere;
    }

    .tabla-categorias td:last-child {
        white-space: nowrap;
    }
</style>

@code {
    private List<Categoria> categorias = new();

    private FormularioCategoria formulario = new();

    private bool cargando = true;
    private bool guardando;
    private bool mostrandoFormulario;
    private bool esEdicion;

    private int? idCategoriaEdicion;

    private string? mensaje;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await CargarCategorias();
    }

    private async Task CargarCategorias()
    {
        cargando = true;
        error = null;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();

            categorias = await db.Categoria
                .AsNoTracking()
                .OrderBy(c => c.Nombre)
                .ToListAsync();
        }
        catch (Exception)
        {
            error = "No se pudieron cargar las categorías. " +
                    "Verifica la conexión con la base de datos.";
        }
        finally
        {
            cargando = false;
        }
    }

    private void NuevaCategoria()
    {
        error = null;
        mensaje = null;

        formulario = new FormularioCategoria();
        idCategoriaEdicion = null;
        esEdicion = false;
        mostrandoFormulario = true;
    }

    private async Task EditarCategoria(int id)
    {
        error = null;
        mensaje = null;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();

            var categoria = await db.Categoria
                .AsNoTracking()
                .FirstOrDefaultAsync(c => c.IdCategoria == id);

            if (categoria is null)
            {
                error = "La categoría ya no existe.";
                await CargarCategorias();
                return;
            }

            formulario = new FormularioCategoria
            {
                Nombre = categoria.Nombre,
                Descripcion = categoria.Descripcion
            };

            idCategoriaEdicion = id;
            esEdicion = true;
            mostrandoFormulario = true;
        }
        catch (Exception)
        {
            error = "No se pudo cargar la categoría para editar.";
        }
    }

    private async Task GuardarCategoria()
    {
        if (guardando)
            return;

        guardando = true;
        error = null;
        mensaje = null;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();

                string nombre = formulario.Nombre.Trim();

                if (string.IsNullOrWhiteSpace(nombre))
                {
                    error = "El nombre de la categoría es obligatorio.";
                    return;
                }

                bool nombreDuplicado = await db.Categoria.AnyAsync(c =>
                    c.Nombre == nombre &&
                    (!esEdicion || c.IdCategoria != idCategoriaEdicion));

                if (nombreDuplicado)
                {
                    error = "Ya existe una categoría con ese nombre.";
                    return;
                }

            if (esEdicion && idCategoriaEdicion.HasValue)
            {
                var categoria = await db.Categoria
                    .FirstOrDefaultAsync(
                        c => c.IdCategoria == idCategoriaEdicion.Value);

                if (categoria is null)
                {
                    error = "La categoría que intentas editar ya no existe.";
                    return;
                }

                categoria.Nombre = formulario.Nombre.Trim();
                categoria.Descripcion =
                    LimpiarDescripcion(formulario.Descripcion);

                await db.SaveChangesAsync();

                mensaje = "Categoría actualizada correctamente.";
            }
            else
            {
                var categoria = new Categoria
                {
                    Nombre = formulario.Nombre.Trim(),
                    Descripcion =
                        LimpiarDescripcion(formulario.Descripcion)
                };

                db.Categoria.Add(categoria);
                await db.SaveChangesAsync();

                mensaje = "Categoría creada correctamente.";
            }

            mostrandoFormulario = false;
            await CargarCategorias();
        }
        catch (DbUpdateException)
        {
            error = "No se pudo guardar la categoría. " +
                    "Comprueba las restricciones y los datos de la base de datos.";
        }
        catch (Exception)
        {
            error = "Ocurrió un error al guardar la categoría.";
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task EliminarCategoria(int id)
    {
        error = null;
        mensaje = null;

        bool confirmar = await JSConfirmar(
            "¿Estás seguro de que deseas eliminar esta categoría?");

        if (!confirmar)
            return;

        if (guardando)
            return;

        guardando = true;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();

            var categoria = await db.Categoria
                .FirstOrDefaultAsync(c => c.IdCategoria == id);

            if (categoria is null)
            {
                error = "La categoría ya no existe.";
                await CargarCategorias();
                return;
            }

            db.Categoria.Remove(categoria);
            await db.SaveChangesAsync();

            mensaje = "Categoría eliminada correctamente.";

            if (idCategoriaEdicion == id)
                CancelarFormulario();

            await CargarCategorias();
        }
        catch (DbUpdateException)
        {
            error = "No se pudo eliminar la categoría. " +
                    "Es posible que tenga vehículos u otros registros asociados.";
        }
        catch (Exception)
        {
            error = "Ocurrió un error al eliminar la categoría.";
        }
        finally
        {
            guardando = false;
        }
    }

    private void CancelarFormulario()
    {
        mostrandoFormulario = false;
        formulario = new FormularioCategoria();
        idCategoriaEdicion = null;
        esEdicion = false;
    }

    private static string? LimpiarDescripcion(string? descripcion)
    {
        return string.IsNullOrWhiteSpace(descripcion)
            ? null
            : descripcion.Trim();
    }

    private async Task<bool> JSConfirmar(string texto)
    {
        return await JS.InvokeAsync<bool>("confirm", texto);
    }

    [Inject]
    private Microsoft.JSInterop.IJSRuntime JS { get; set; } = default!;

    private sealed class FormularioCategoria
    {
        [Required(ErrorMessage = "El nombre es obligatorio.")]
        [StringLength(50, ErrorMessage = "Máximo 50 caracteres.")]
        public string Nombre { get; set; } = string.Empty;

        [StringLength(200, ErrorMessage = "Máximo 200 caracteres.")]
        public string? Descripcion { get; set; }
    }
}

